<section class="rounded-2xl border border-neutral-800 bg-neutral-950 @Class">
    @if (Cabecera)
    {
        <header class="flex flex-wrap items-start justify-between gap-4 px-5 pt-5 sm:px-6">
            <div>
                @if (!string.IsNullOrEmpty(Titulo))
                {
                    <h2 class="text-base font-bold text-white">@Titulo</h2>
                }
                @if (!string.IsNullOrEmpty(Descripcion))
                {
                    <p class="mt-1 text-sm text-neutral-400">@Descripcion</p>
                }
            </div>
            @Accion
        </header>
    }
    <div class="@Cuerpo">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Descripcion { get; set; }
    [Parameter] public RenderFragment? Accion { get; set; }
    [Parameter] public bool Relleno { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool Cabecera => !string.IsNullOrEmpty(Titulo) || Accion is not null;

    private string Cuerpo
    {
        get
        {
            if (Relleno) return Cabecera ? "px-5 pb-5 pt-5 sm:px-6 sm:pb-6" : "p-5 sm:p-6";
            return Cabecera ? "mt-5" : "";
        }
    }
}