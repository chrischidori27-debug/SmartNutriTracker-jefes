@implements IDisposable

<div role="status" aria-live="polite"
     class="pointer-events-none fixed inset-x-4 bottom-24 z-50 flex justify-center lg:inset-x-auto lg:bottom-8 lg:right-8 lg:justify-end">
    @if (Info is not null)
    {
        <div @key="Info.Id"
             class="aviso-entrada pointer-events-auto flex items-center gap-3 rounded-xl border border-green-500/40 bg-neutral-950 py-3 pl-4 pr-3 shadow-2xl shadow-black">
            <IconoSvg Nombre="check" Class="h-5 w-5 shrink-0 text-green-400" />
            <p class="text-sm font-medium text-white">@Info.Mensaje</p>
            <button type="button" @onclick="() => OnCerrar.InvokeAsync()" aria-label="Cerrar aviso"
                    class="rounded p-1 text-neutral-500 transition-colors hover:text-white">
                <IconoSvg Nombre="x" Class="h-4 w-4" />
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public AvisoInfo? Info { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    private long? _idActual;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        var id = Info?.Id;
        if (id == _idActual) return;
        _idActual = id;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;

        if (id is null) return;
        _cts = new CancellationTokenSource();
        _ = CerrarTrasEspera(_cts.Token);
    }

    private async Task CerrarTrasEspera(CancellationToken token)
    {
        try
        {
            await Task.Delay(3500, token);
            await InvokeAsync(() => OnCerrar.InvokeAsync());
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}