<div class="grid place-items-center rounded-2xl border border-dashed border-neutral-800 px-6 py-16 text-center">
    <div class="max-w-sm">
        <h2 class="text-lg font-bold text-white">@Titulo</h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-400">@Descripcion</p>
        @if (Accion is not null)
        {
            <div class="mt-6">@Accion</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Descripcion { get; set; } = "";
    [Parameter] public RenderFragment? Accion { get; set; }
}