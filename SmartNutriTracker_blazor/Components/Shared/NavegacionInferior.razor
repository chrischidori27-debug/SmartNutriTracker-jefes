<nav aria-label="Principal"
     class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 border-t border-neutral-800 bg-black/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden">
    @foreach (var seccion in Secciones.Todas)
    {
        var activo = seccion.Id == Activa;
        <button type="button" @key="seccion.Id"
                @onclick="() => OnCambiar.InvokeAsync(seccion.Id)"
                aria-current="@(activo ? "page" : null)"
                class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-semibold transition-colors @(activo ? "text-green-400" : "text-neutral-500 hover:text-white")">
            <IconoSvg Nombre="@seccion.Icono" Class="h-5 w-5" />
            @seccion.Etiqueta
        </button>
    }
</nav>

@code {
    [Parameter] public string Activa { get; set; } = "";
    [Parameter] public EventCallback<string> OnCambiar { get; set; }
}