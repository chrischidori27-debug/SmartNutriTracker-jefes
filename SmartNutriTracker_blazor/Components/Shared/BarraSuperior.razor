<header class="sticky top-0 z-30 flex items-center justify-between border-b border-neutral-800 bg-black/90 px-4 py-3 backdrop-blur lg:hidden">
    <Marca />
    <button type="button" @onclick="() => OnActualizar.InvokeAsync()" aria-label="Actualizar datos"
            class="grid h-10 w-10 place-items-center rounded-lg border border-neutral-800 text-neutral-300 transition-colors hover:bg-neutral-900 hover:text-white">
        <IconoSvg Nombre="refresh" Class="h-4 w-4" />
    </button>
</header>

@code {
    [Parameter] public EventCallback OnActualizar { get; set; }
}