@if (Seleccionado is null)
{
    <EncabezadoPagina Titulo="Mi perfil" Descripcion="Consulta tus medidas y actualiza tu peso y objetivo." />
    <EstadoVacio Titulo="Aún no hay estudiantes" Descripcion="Registra al primer estudiante para ver su perfil nutricional.">
        <Accion>
            <button type="button" @onclick="() => OnIrARegistro.InvokeAsync()" class="@Estilos.BotonPrimario">
                Ir al registro
            </button>
        </Accion>
    </EstadoVacio>
}
else
{
    var control = Nutricion.UltimoControl(Seleccionado) ?? new ControlDTO();
    var edad = Nutricion.CalcularEdad(Seleccionado.FechaNacimiento);
    var historial = Seleccionado.Historial;
    var recientes = Enumerable.Reverse(
        historial
            .Select((r, i) => (Registro: r, Cambio: i > 0
                ? (double?)Math.Round(r.Peso - historial[i - 1].Peso, 1, MidpointRounding.AwayFromZero)
                : null))
            .TakeLast(5)
            .ToList()).ToList();

    <EncabezadoPagina Titulo="Mi perfil" Descripcion="Consulta tus medidas y actualiza tu peso y objetivo.">
        <div class="sm:w-80">
            <label for="perfil-estudiante" class="mb-1.5 block text-sm font-medium text-neutral-400">Ver como</label>
            <select id="perfil-estudiante" class="@Estilos.Campo" value="@Seleccionado.Id" @onchange="AlCambiarEstudiante">
                @foreach (var opcion in Estudiantes)
                {
                    <option @key="opcion.Id" value="@opcion.Id">@opcion.Nombre</option>
                }
            </select>
        </div>
    </EncabezadoPagina>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
        <div class="space-y-6">
            <Panel>
                <div class="flex flex-wrap items-center gap-4">
                    <Avatar Nombre="@Seleccionado.Nombre" Tamano="lg" />
                    <div class="min-w-[12rem] flex-1">
                        <h2 class="truncate text-xl font-bold text-white">@Seleccionado.Nombre</h2>
                        <p class="truncate text-sm text-neutral-400">@Seleccionado.Correo</p>
                    </div>
                    <span class="rounded-full border border-green-500/40 bg-green-500/10 px-3 py-1 text-xs font-semibold text-green-300">@Seleccionado.Objetivo</span>
                </div>

                <dl class="mt-6 grid grid-cols-3 divide-x divide-neutral-800 border-t border-neutral-800 pt-5">
                    <div class="pr-4">
                        <dt class="text-sm text-neutral-400">Edad</dt>
                        <dd class="mt-1 text-lg font-bold tabular-nums text-white">@edad años</dd>
                    </div>
                    <div class="px-4">
                        <dt class="text-sm text-neutral-400">Altura</dt>
                        <dd class="mt-1 text-lg font-bold tabular-nums text-white">@Nutricion.Dec(Seleccionado.Altura, 2) m</dd>
                    </div>
                    <div class="pl-4">
                        <dt class="text-sm text-neutral-400">Peso actual</dt>
                        <dd class="mt-1 text-lg font-bold tabular-nums text-white">@Nutricion.Dec(control.Peso) kg</dd>
                    </div>
                </dl>
            </Panel>

            <Panel Titulo="Índice de masa corporal">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <p class="text-6xl font-extrabold tabular-nums leading-none text-white">@Nutricion.Dec(control.Imc)<span class="ml-2 text-sm font-medium text-neutral-500">kg/m²</span></p>
                    @if (control.Imc > 0)
                    {
                        <ChipIMC Imc="control.Imc" />
                    }
                </div>
                <div class="mt-8">
                    <EscalaIMC Imc="control.Imc" />
                </div>
            </Panel>

            <Panel Titulo="Controles recientes" Relleno="false" Class="overflow-hidden">
                <ul class="divide-y divide-neutral-800 border-t border-neutral-800">
                    @foreach (var item in recientes)
                    {
                        <li @key="item.Registro.Id"
                            class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 px-5 py-3.5 sm:grid-cols-[1fr_1fr_1fr_auto] sm:px-6">
                            <span class="text-sm text-neutral-300">@Nutricion.FormatearFecha(item.Registro.Fecha)</span>
                            <span class="text-right text-sm font-bold tabular-nums text-white sm:text-left">@Nutricion.Dec(item.Registro.Peso) kg</span>
                            <span class="col-start-1 sm:col-start-auto"><CambioPeso Cambio="item.Cambio" /></span>
                            <span class="text-right text-xs tabular-nums text-neutral-500">IMC @Nutricion.Dec(item.Registro.Imc)</span>
                        </li>
                    }
                </ul>
            </Panel>
        </div>

        <div class="lg:sticky lg:top-10 lg:self-start">
            <Panel Titulo="Actualizar medidas" Descripcion="Registra tu peso más reciente.">
                <FormularioActualizacion @key="Seleccionado.Id" Estudiante="Seleccionado"
                                         OnGuardado="OnGuardado" OnAviso="OnAviso" />
            </Panel>
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<EstudianteDTO> Estudiantes { get; set; } = Array.Empty<EstudianteDTO>();
    [Parameter] public EstudianteDTO? Seleccionado { get; set; }
    [Parameter] public EventCallback<int> OnSeleccionar { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public EventCallback<string> OnAviso { get; set; }
    [Parameter] public EventCallback OnIrARegistro { get; set; }

    private Task AlCambiarEstudiante(ChangeEventArgs e) =>
        OnSeleccionar.InvokeAsync(Convert.ToInt32(e.Value, CultureInfo.InvariantCulture));
}