@inject PerfilService Perfiles

@if (Seleccionado is null)
{
    <EncabezadoPagina Titulo="Seguimiento nutricional" Descripcion="Evalúa la evolución de peso e IMC de cada estudiante." />
    <EstadoVacio Titulo="Aún no hay estudiantes" Descripcion="Registra estudiantes para poder dar seguimiento a su progreso.">
        <Accion>
            <button type="button" @onclick="() => OnIrARegistro.InvokeAsync()" class="@Estilos.BotonPrimario">
                Ir al registro
            </button>
        </Accion>
    </EstadoVacio>
}
else
{
    var ultimo = Nutricion.UltimoControl(Seleccionado);
    var control = ultimo ?? new ControlDTO();
    var variacion = Nutricion.VariacionPeso(Seleccionado);
    var favorable = Nutricion.VariacionFavorable(Seleccionado.Objetivo, variacion);
    var metricaActiva = Metricas.First(m => m.Clave == metrica);
    var puntos = Seleccionado.Historial
        .Select(r => new PuntoGrafico(r.Fecha, metrica == "peso" ? r.Peso : r.Imc))
        .ToList();
    var registros = Enumerable.Reverse(Seleccionado.Historial).ToList();
    var filtrados = Filtrar();

    <EncabezadoPagina Titulo="Seguimiento nutricional" Descripcion="Evalúa la evolución de peso e IMC de cada estudiante." />

    <div class="grid gap-6 lg:grid-cols-[280px_minmax(0,1fr)]">
        <Panel Relleno="false" Class="self-start overflow-hidden">
            <div class="border-b border-neutral-800 p-4">
                <label for="seguimiento-busqueda" class="sr-only">Buscar estudiante</label>
                <div class="relative">
                    <IconoSvg Nombre="search" Class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500" />
                    <input id="seguimiento-busqueda" type="search" autocomplete="off" placeholder="Buscar estudiante"
                           class="@Estilos.Campo pl-9" @bind="busqueda" @bind:event="oninput" />
                </div>
            </div>
            <ul class="max-h-[32rem] overflow-y-auto p-2">
                @foreach (var opcion in filtrados)
                {
                    var activo = opcion.Id == Seleccionado.Id;
                    var ultimoOpcion = Nutricion.UltimoControl(opcion);
                    <li @key="opcion.Id">
                        <button type="button" @onclick="() => OnSeleccionar.InvokeAsync(opcion.Id)"
                                aria-current="@(activo ? "true" : null)"
                                class="flex w-full items-center gap-3 rounded-lg border px-3 py-2.5 text-left transition-colors @(activo ? "border-green-500/40 bg-green-500/10" : "border-transparent hover:bg-neutral-900")">
                            <Avatar Nombre="@opcion.Nombre" Tamano="sm" />
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-semibold text-white">@opcion.Nombre</span>
                                <span class="block truncate text-xs text-neutral-500">@opcion.Objetivo</span>
                            </span>
                            @if (ultimoOpcion is not null)
                            {
                                <span class="flex items-center gap-1.5 text-xs font-semibold tabular-nums text-neutral-300">
                                    <span class="h-1.5 w-1.5 rounded-full @Nutricion.CategoriaIMC(ultimoOpcion.Imc).Punto"></span>
                                    @Nutricion.Dec(ultimoOpcion.Imc)
                                </span>
                            }
                        </button>
                    </li>
                }
                @if (!filtrados.Any())
                {
                    <li class="px-3 py-8 text-center text-sm text-neutral-500">Ningún estudiante coincide con la búsqueda.</li>
                }
            </ul>
        </Panel>

        <div class="min-w-0 space-y-6">
            <Panel>
                <div class="flex flex-wrap items-center gap-4">
                    <Avatar Nombre="@Seleccionado.Nombre" Tamano="md" />
                    <div class="min-w-[12rem] flex-1">
                        <h2 class="truncate text-lg font-bold text-white">@Seleccionado.Nombre</h2>
                        <p class="truncate text-sm text-neutral-400">@Seleccionado.Correo · @Nutricion.Dec(Seleccionado.Altura, 2) m</p>
                    </div>
                    <span class="rounded-full border border-green-500/40 bg-green-500/10 px-3 py-1 text-xs font-semibold text-green-300">@Seleccionado.Objetivo</span>
                </div>
            </Panel>

            <FranjaDatos Columnas="4">
                <DatoFranja Etiqueta="Peso actual">
                    <Valor>@Nutricion.Dec(control.Peso)<span class="ml-1 text-sm font-medium text-neutral-500">kg</span></Valor>
                    <Detalle>@(ultimo is not null ? $"Control del {Nutricion.FormatearFecha(control.Fecha)}" : "")</Detalle>
                </DatoFranja>
                <DatoFranja Etiqueta="Variación total">
                    <Valor>
                        <span class="@(favorable ? "text-green-400" : "text-white")">@Nutricion.Signo(variacion)<span class="ml-1 text-sm font-medium text-neutral-500">kg</span></span>
                    </Valor>
                    <Detalle>@(favorable ? "Acorde al objetivo" : "Desde el primer control")</Detalle>
                </DatoFranja>
                <DatoFranja Etiqueta="IMC actual">
                    <Valor>@Nutricion.Dec(control.Imc)</Valor>
                    <Detalle>
                        @if (control.Imc > 0)
                        {
                            <ChipIMC Imc="control.Imc" />
                        }
                    </Detalle>
                </DatoFranja>
                <DatoFranja Etiqueta="Controles">
                    <Valor>@Seleccionado.Historial.Count</Valor>
                    <Detalle>Registrados en total</Detalle>
                </DatoFranja>
            </FranjaDatos>

            <Panel Titulo="Evolución" Descripcion="@($"{metricaActiva.Nombre} por fecha de control")">
                <Accion>
                    <div role="group" aria-label="Métrica del gráfico"
                         class="flex rounded-lg border border-neutral-800 bg-black p-1 text-sm font-semibold">
                        @foreach (var opcion in Metricas)
                        {
                            <button type="button" @key="opcion.Clave"
                                    aria-pressed="@(metrica == opcion.Clave ? "true" : "false")"
                                    @onclick="() => metrica = opcion.Clave"
                                    class="rounded-md px-3 py-1.5 transition-colors @(metrica == opcion.Clave ? "bg-green-500 text-black" : "text-neutral-400 hover:text-white")">
                                @opcion.Etiqueta
                            </button>
                        }
                    </div>
                </Accion>
                <ChildContent>
                    <GraficoProgreso Puntos="puntos" Nombre="@metricaActiva.Nombre" Unidad="@metricaActiva.Unidad" />
                </ChildContent>
            </Panel>

            <Panel Titulo="Registro de controles" Relleno="false" Class="overflow-hidden">
                <div class="overflow-x-auto border-t border-neutral-800">
                    <table class="w-full min-w-[32rem] text-left text-sm">
                        <thead>
                            <tr class="border-b border-neutral-800 text-neutral-400">
                                <th scope="col" class="px-5 py-3 font-medium sm:px-6">Fecha</th>
                                <th scope="col" class="px-5 py-3 font-medium">Peso</th>
                                <th scope="col" class="px-5 py-3 font-medium">IMC</th>
                                <th scope="col" class="px-5 py-3 font-medium sm:pr-6">Clasificación</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-800">
                            @foreach (var registro in registros)
                            {
                                <tr @key="registro.Id" class="transition-colors hover:bg-neutral-900/60">
                                    <td class="px-5 py-3.5 text-neutral-300 sm:px-6">@Nutricion.FormatearFecha(registro.Fecha)</td>
                                    <td class="px-5 py-3.5 font-bold tabular-nums text-white">@Nutricion.Dec(registro.Peso) kg</td>
                                    <td class="px-5 py-3.5 tabular-nums text-neutral-300">@Nutricion.Dec(registro.Imc)</td>
                                    <td class="px-5 py-3.5 sm:pr-6"><ChipIMC Imc="registro.Imc" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Panel>

            <Panel Titulo="Reporte semanal" Descripcion="Resumen automático por semana, de lunes a domingo."
                   Relleno="false" Class="overflow-hidden">
                @if (errorReporte)
                {
                    <p class="border-t border-neutral-800 px-5 py-8 text-center text-sm text-neutral-500 sm:px-6">No se pudo cargar el reporte semanal.</p>
                }
                else if (reporte is null)
                {
                    <p class="border-t border-neutral-800 px-5 py-8 text-center text-sm text-neutral-500 sm:px-6">Cargando reporte…</p>
                }
                else
                {
                    <div class="overflow-x-auto border-t border-neutral-800">
                        <table class="w-full min-w-[40rem] text-left text-sm">
                            <thead>
                                <tr class="border-b border-neutral-800 text-neutral-400">
                                    <th scope="col" class="px-5 py-3 font-medium sm:px-6">Semana</th>
                                    <th scope="col" class="px-5 py-3 font-medium">Controles</th>
                                    <th scope="col" class="px-5 py-3 font-medium">Peso promedio</th>
                                    <th scope="col" class="px-5 py-3 font-medium">Peso final</th>
                                    <th scope="col" class="px-5 py-3 font-medium">Variación</th>
                                    <th scope="col" class="px-5 py-3 font-medium sm:pr-6">IMC final</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-neutral-800">
                                @foreach (var semana in Enumerable.Reverse(reporte.Semanas))
                                {
                                    <tr @key="semana.Inicio" class="transition-colors hover:bg-neutral-900/60">
                                        <td class="px-5 py-3.5 text-neutral-300 sm:px-6">@Nutricion.FormatearFecha(semana.Inicio, true) – @Nutricion.FormatearFecha(semana.Fin, true)</td>
                                        <td class="px-5 py-3.5 tabular-nums text-neutral-300">@semana.Controles</td>
                                        <td class="px-5 py-3.5 tabular-nums text-neutral-300">@Nutricion.Dec(semana.PesoPromedio) kg</td>
                                        <td class="px-5 py-3.5 font-bold tabular-nums text-white">@Nutricion.Dec(semana.PesoFinal) kg</td>
                                        <td class="px-5 py-3.5"><CambioPeso Cambio="semana.Variacion" /></td>
                                        <td class="px-5 py-3.5 sm:pr-6">
                                            <span class="mr-2 tabular-nums text-neutral-300">@Nutricion.Dec(semana.ImcFinal)</span>
                                            <ChipIMC Imc="semana.ImcFinal" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Panel>
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<EstudianteDTO> Estudiantes { get; set; } = Array.Empty<EstudianteDTO>();
    [Parameter] public EstudianteDTO? Seleccionado { get; set; }
    [Parameter] public EventCallback<int> OnSeleccionar { get; set; }
    [Parameter] public EventCallback OnIrARegistro { get; set; }

    private record Metrica(string Clave, string Etiqueta, string Nombre, string Unidad);

    private static readonly Metrica[] Metricas =
    {
        new("peso", "Peso (kg)", "Peso", "kg"),
        new("imc", "IMC", "IMC", "kg/m²"),
    };

    private string busqueda = "";
    private string metrica = "peso";

    private ReporteSemanalDTO? reporte;
    private bool errorReporte;
    private int _idReporte = -1;
    private int _conteoReporte = -1;
    private double _pesoReporte = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (Seleccionado is null)
        {
            reporte = null;
            _idReporte = -1;
            return;
        }

        var id = Seleccionado.Id;
        var conteo = Seleccionado.Historial.Count;
        var peso = Seleccionado.Historial.LastOrDefault()?.Peso ?? 0;
        if (id == _idReporte && conteo == _conteoReporte && peso == _pesoReporte) return;

        _idReporte = id;
        _conteoReporte = conteo;
        _pesoReporte = peso;
        if (reporte?.EstudianteId != id) reporte = null;
        errorReporte = false;

        try
        {
            var nuevo = await Perfiles.ObtenerReporteSemanalAsync(id);
            if (_idReporte == id) reporte = nuevo;
        }
        catch (Exception)
        {
            if (_idReporte == id) errorReporte = true;
        }
    }

    private List<EstudianteDTO> Filtrar()
    {
        var termino = busqueda.Trim();
        if (termino.Length == 0) return Estudiantes.ToList();
        return Estudiantes
            .Where(e => e.Nombre.Contains(termino, StringComparison.OrdinalIgnoreCase)
                        || e.Correo.Contains(termino, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}