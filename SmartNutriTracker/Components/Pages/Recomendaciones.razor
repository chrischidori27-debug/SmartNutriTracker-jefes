@page "/recomendaciones"
@rendermode InteractiveServer
@using SmartNutriTracker.Servicios
@inject RecomendacionServicio RecomendacionService

<PageTitle>Recomendaciones Inteligentes | SmartNutriTracker</PageTitle>

<div class="rec-page">

    <div class="rec-header">
        <span class="rec-badge">
            <span class="rec-badge-dot"></span>
            HU-23 · HU-24 · HU-25 · HU-26 · MOTOR NUTRICIONAL
        </span>
        <h1>Recomendaciones Nutricionales <span>Inteligentes</span></h1>
        <p class="rec-subtitle">
            Diagnóstico por IMC, alertas preventivas de salud, distribución porcentual de macronutrientes y menú personalizado.
        </p>
    </div>

    <div class="rec-panel">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="rec-label">Peso (kg)</label>
                <input type="number" step="0.1" class="rec-input" @bind="pesoKg" />
            </div>
            <div class="col-md-2">
                <label class="rec-label">Altura (m o cm)</label>
                <input type="number" step="0.01" class="rec-input" @bind="altura" />
            </div>
            <div class="col-md-2">
                <label class="rec-label">Edad (años)</label>
                <input type="number" class="rec-input" @bind="edad" />
            </div>
            <div class="col-md-2">
                <label class="rec-label">Sexo</label>
                <select class="rec-input" @bind="sexo">
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="rec-label">Objetivo Nutricional (HU-25)</label>
                <select class="rec-input" @bind="objetivoSeleccionado">
                    <option value="">Automático según mi IMC</option>
                    <option value="@ObjetivoNutricional.BajarPeso">Bajar de peso (Déficit)</option>
                    <option value="@ObjetivoNutricional.MantenerPeso">Mantener peso (Equilibrio)</option>
                    <option value="@ObjetivoNutricional.GanarPeso">Ganar peso / masa (Superávit)</option>
                </select>
            </div>
        </div>

        <div class="mt-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <button class="rec-btn-primary" @onclick="CalcularAsync">
                ★ Generar Plan y Diagnóstico
            </button>
            <small class="text-secondary">
                Fórmula Mifflin-St Jeor + evaluación de riesgo nutricional.
            </small>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="rec-alert-error">@mensajeError</div>
        }
    </div>

    @if (plan != null)
    {
        <!-- 1. ALERTAS DE RIESGO Y ADVERTENCIAS -->
        <div class="rec-alerts-stack">
            @foreach (var alerta in plan.Alertas)
            {
                <div class="rec-alert-box @alerta.Nivel">
                    <div class="rec-alert-icon">
                        @(alerta.Nivel == "peligro" ? "⚠" : alerta.Nivel == "advertencia" ? "⚡" : "✔")
                    </div>
                    <div>
                        <div class="rec-alert-title">@alerta.Titulo</div>
                        <p class="rec-alert-text">@alerta.Mensaje</p>
                    </div>
                </div>
            }
        </div>

        <!-- 2. TARJETAS KPI DE MÉTRICAS Y PORCENTAJES -->
        <div class="rec-kpi-grid">
            <div class="rec-kpi-card accent-blue">
                <div>
                    <div class="rec-kpi-tag">Diagnóstico IMC · HU-24</div>
                    <div class="rec-kpi-value">
                        @plan.Imc.ToString("0.0") <small>(@plan.CategoriaImc)</small>
                    </div>
                </div>
                <p class="rec-kpi-desc">@plan.MensajeImc</p>
            </div>

            <div class="rec-kpi-card">
                <div>
                    <div class="rec-kpi-tag">Distribución Diaria · @FormatearObjetivo(plan.ObjetivoAplicado)</div>
                    <div class="rec-kpi-value">
                        @plan.CaloriasObjetivoDiario <small>kcal / día</small>
                    </div>
                    <div class="rec-macro-bar" title="Distribución porcentual de macronutrientes">
                        <div class="rec-seg-prot" style="width: @(plan.PorcentajeProteinas)%"></div>
                        <div class="rec-seg-carb" style="width: @(plan.PorcentajeCarbohidratos)%"></div>
                        <div class="rec-seg-grasa" style="width: @(plan.PorcentajeGrasas)%"></div>
                    </div>
                </div>
                <div class="rec-macros-pills">
                    <span class="rec-pill">Prot (@plan.PorcentajeProteinas%): <strong>@plan.ProteinasObjetivoGramos g</strong></span>
                    <span class="rec-pill">Carb (@plan.PorcentajeCarbohidratos%): <strong>@plan.CarbohidratosObjetivoGramos g</strong></span>
                    <span class="rec-pill">Grasas (@plan.PorcentajeGrasas%): <strong>@plan.GrasasObjetivoGramos g</strong></span>
                    <span class="rec-pill">Fibra: <strong>@plan.FibraObjetivoGramos g</strong></span>
                    <span class="rec-pill">Agua: <strong>@plan.AguaRecomendadaLitros L</strong></span>
                </div>
            </div>

            <div class="rec-kpi-card accent-amber">
                <div>
                    <div class="rec-kpi-tag">Cobertura del Menú Sugerido · HU-26</div>
                    <div class="rec-kpi-value">
                        @plan.ResumenMenuSugerido.Calorias.ToString("0") <small>kcal (@CalcularPorcentajeCobertura()% de la meta)</small>
                    </div>
                </div>
                <div>
                    <div class="rec-macros-pills">
                        <span class="rec-pill">Prot: <strong>@plan.ResumenMenuSugerido.Proteinas g</strong> (@plan.ResumenMenuSugerido.PorcentajeProteinas%)</span>
                        <span class="rec-pill">Carb: <strong>@plan.ResumenMenuSugerido.Carbohidratos g</strong> (@plan.ResumenMenuSugerido.PorcentajeCarbohidratos%)</span>
                        <span class="rec-pill">Grasas: <strong>@plan.ResumenMenuSugerido.Grasas g</strong> (@plan.ResumenMenuSugerido.PorcentajeGrasas%)</span>
                    </div>
                    <div class="rec-progress-wrap">
                        <div class="rec-progress-track">
                            <div class="rec-progress-fill" style="width: @(CalcularPorcentajeCobertura())%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. DESGLOSE POR TIEMPO DE COMIDA -->
        <div class="rec-panel">
            <h3 class="h6 text-uppercase text-secondary fw-bold mb-3">
                ¿Cuánto consumir en cada comida del día? (Distribución Porcentual)
            </h3>
            <div class="rec-meals-grid mb-0">
                @foreach (var comida in plan.DistribucionComidas)
                {
                    <div class="rec-meal-card">
                        <div class="rec-meal-head">
                            <span class="rec-meal-name">@comida.TiempoComida</span>
                            <span class="rec-meal-pct">@comida.PorcentajeCalorias% del día</span>
                        </div>
                        <div class="rec-meal-kcal">@comida.Calorias kcal</div>
                        <div class="rec-macros-pills">
                            <span class="rec-pill">P: <strong>@comida.ProteinasGramos g</strong></span>
                            <span class="rec-pill">C: <strong>@comida.CarbohidratosGramos g</strong></span>
                            <span class="rec-pill">G: <strong>@comida.GrasasGramos g</strong></span>
                        </div>
                        <p class="rec-meal-guide">@comida.GuiaPractica</p>
                    </div>
                }
            </div>
        </div>

        <!-- 4. RECOMENDACIONES ESPECÍFICAS -->
        <div class="rec-panel">
            <h3 class="h6 text-uppercase text-secondary fw-bold mb-3">
                Pautas Específicas para tu Perfil y Objetivo
            </h3>
            <ul class="rec-tips-list">
                @foreach (var pauta in plan.RecomendacionesEspecificas)
                {
                    <li>@pauta</li>
                }
            </ul>
        </div>

        <!-- 5. TABLA DE MENÚ SUGERIDO -->
        <div class="rec-table-card">
            <div class="rec-table-header">
                <h3>Menú Saludable Sugerido del Catálogo (HU-23)</h3>
                <span class="rec-pill">@plan.MenuSugerido.Count alimento(s) seleccionado(s)</span>
            </div>

            @if (plan.MenuSugerido.Count == 0)
            {
                <div class="rec-empty-state">
                    No hay alimentos activos registrados en la base de datos para armar el menú. Registra alimentos primero en el módulo de <strong>Alimentos</strong>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="rec-table">
                        <thead>
                            <tr>
                                <th>Momento</th>
                                <th>Alimento</th>
                                <th>Categoría</th>
                                <th>Porción</th>
                                <th>Calorías</th>
                                <th>Aporte Meta</th>
                                <th>Proteínas</th>
                                <th>Carbohidratos</th>
                                <th>Grasas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in plan.MenuSugerido)
                            {
                                <tr>
                                    <td><span class="rec-pill">@item.TiempoComidaSugerido</span></td>
                                    <td><strong>@item.Nombre</strong></td>
                                    <td><span class="rec-cat-badge">@(item.Categoria ?? "General")</span></td>
                                    <td>@item.CantidadPorciones.ToString("0.00") x (@item.Porcion)</td>
                                    <td class="rec-kcal-highlight">@item.Calorias.ToString("0.0") kcal</td>
                                    <td><strong>@item.PorcentajeMetaCalorica%</strong></td>
                                    <td>@item.Proteinas.ToString("0.0") g</td>
                                    <td>@item.Carbohidratos.ToString("0.0") g</td>
                                    <td>@item.Grasas.ToString("0.0") g</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private decimal pesoKg = 68m;
    private decimal altura = 1.70m;
    private int edad = 16;
    private string sexo = "M";
    private string objetivoSeleccionado = "";
    private string? mensajeError;
    private PlanRecomendacionDto? plan;

    private async Task CalcularAsync()
    {
        mensajeError = null;
        try
        {
            ObjetivoNutricional? objetivo = Enum.TryParse<ObjetivoNutricional>(objetivoSeleccionado, out var parsed)
                ? parsed
                : null;

            plan = await RecomendacionService.GenerarRecomendacionAsync(
                pesoKg, altura, edad, sexo, objetivo);
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private static string FormatearObjetivo(ObjetivoNutricional obj) => obj switch
    {
        ObjetivoNutricional.BajarPeso => "Bajar de peso",
        ObjetivoNutricional.GanarPeso => "Ganar peso / masa",
        _ => "Mantener peso"
    };

    private int CalcularPorcentajeCobertura()
    {
        if (plan == null || plan.CaloriasObjetivoDiario <= 0) return 0;
        var pct = (int)Math.Round((plan.ResumenMenuSugerido.Calorias / plan.CaloriasObjetivoDiario) * 100);
        return Math.Clamp(pct, 0, 100);
    }
}